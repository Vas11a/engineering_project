NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Application traffic: pooled Neon URL. Local PostgreSQL works as well.
DATABASE_URL=postgresql://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Migrations: direct URL, hostname without -pooler.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Create a bot using @BotFather. Never expose this token in frontend variables.
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400
# Browser-only development identity. Must be false in production.
DEV_AUTH_ENABLED=true
DEV_TELEGRAM_ID=100000001
DEV_TELEGRAM_FIRST_NAME=Local developer

# disabled: API only; polling: local bot; webhook: deployed bot.
BOT_MODE=disabled
# Required for webhook. Optional in polling: without it the bot replies with text only.
# A Telegram app button needs a publicly reachable HTTPS frontend, not localhost.
# MINI_APP_URL=https://your-app.vercel.app
# Required for bot:setup in webhook mode.
# PUBLIC_API_URL=https://your-api.onrender.com
# Random 16-256 characters: A-Z a-z 0-9 _ -
# TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Optional AI; absent key disables AI without blocking manual creation.
# AI_API_KEY=replace-with-your-provider-key
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5-mini
AI_TIMEOUT_MS=20000
AI_REQUESTS_PER_HOUR=20
# Alternative: Neon AI Gateway bare branch host (/v1 added by backend).
# NEON_AI_GATEWAY_TOKEN=nt_live_replace-me
# NEON_AI_GATEWAY_BASE_URL=https://your-branch-api.ai.eu-central-1.aws.neon.tech
