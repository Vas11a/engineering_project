NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Use the pooled Neon URL for normal application traffic.
DATABASE_URL=postgresql://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Use the direct Neon URL for Prisma migrations and other administrative tasks.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Telegram bot token is used only on the backend to verify Mini App initData.
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400

# Explicit local-only fallback for opening the frontend outside Telegram.
# This setting is rejected when NODE_ENV=production.
DEV_AUTH_ENABLED=true
DEV_TELEGRAM_ID=100000001
DEV_TELEGRAM_FIRST_NAME=Local developer
